{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoTool",
  "version": "1.0.0",
  "identifier": "com.phototool.desktop",
  "build": {
    "frontendDist": "../.web/build/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run web:start",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\build_frontend.ps1"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "loading.html",
        "title": "PhotoTool · 个人图片处理工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f4f7fb"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["../build/tauri-resources/sidecar/PhotoToolSidecar.exe"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "icon": ["../assets/img/logo.ico"]
  }
}
