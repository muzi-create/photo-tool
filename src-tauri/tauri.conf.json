{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoTool",
  "version": "1.0.0",
  "identifier": "com.phototool.desktop",
  "build": {
    "frontendDist": "../.web/build/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "python -m reflex run",
    "beforeBuildCommand": "python -m reflex compile"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PhotoTool · 企业级图片处理工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f4f7fb"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["../dist/sidecar/PhotoToolSidecar.exe"],
    "icon": ["../assets/img/logo.ico"]
  }
}
